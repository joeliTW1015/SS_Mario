{
  "rules": {
    "leaderboard": {
      ".read": true,
      ".write": true,
      ".indexOn": ["score"],
      "$entry": {
        ".validate": "newData.hasChildren(['username', 'level', 'score', 'timestamp'])",
        "username": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "level": { ".validate": "newData.isNumber()" },
        "score": { ".validate": "newData.isNumber()" },
        "coins": { ".validate": "newData.isNumber() || !newData.exists()" },
        "timestamp": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['username', 'email'])",
        "username": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "email": { ".validate": "newData.isString()" },
        "createdAt": { ".validate": "newData.isNumber() || !newData.exists()" },
        "gameProgress": {
          "lives":   { ".validate": "newData.isNumber()" },
          "level":   { ".validate": "newData.isNumber()" },
          "score":   { ".validate": "newData.isNumber() || !newData.exists()" },
          "savedAt": { ".validate": "newData.isNumber()" },
          "$other":  { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    },
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['x', 'y'])",
            "name":        { ".validate": "newData.isString() && newData.val().length <= 20" },
            "x":           { ".validate": "newData.isNumber()" },
            "y":           { ".validate": "newData.isNumber()" },
            "facingRight": { ".validate": "newData.isBoolean()" },
            "anim":        { ".validate": "newData.isString() && newData.val().length <= 20" },
            "state":       { ".validate": "newData.isString() && newData.val().length <= 12" },
            "updatedAt":   { ".validate": "newData.isNumber()" },
            "$other":      { ".validate": false }
          }
        }
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
